# No real values belong in this file or in any committed .env file.
HTTP_PORT=8080
# products_app login role on the shared instance; products_schema is
# created by synkro-products-db's migrations.
DATABASE_URL=postgres://products_app:<password>@synkro-db:5432/synkro?sslmode=disable
# RS256 public key of synkro-auth-api (PEM, newlines as \n so it fits one
# line). Exactly one of JWT_PUBLIC_KEY or JWT_PUBLIC_KEY_FILE is required;
# the service refuses to start without it. Only the PUBLIC key belongs
# here: the private key exists only in synkro-auth-api (ADR-006).
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n<public key body>\n-----END PUBLIC KEY-----
# JWT_PUBLIC_KEY_FILE=/run/secrets/jwt_public_key
